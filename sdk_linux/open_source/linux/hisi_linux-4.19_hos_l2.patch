+#include "skeleton.dtsi"
+#include <dt-bindings/clock/hi3536dv100-clock.h>
+/ {
+	aliases {
+		serial0 = &uart0;
+		i2c0 = &i2c_bus0;
+		gpio0 = &gpio_chip0;
+		gpio1 = &gpio_chip1;
+		gpio2 = &gpio_chip2;
+		gpio3 = &gpio_chip3;
+		gpio4 = &gpio_chip4;
+		gpio5 = &gpio_chip5;
