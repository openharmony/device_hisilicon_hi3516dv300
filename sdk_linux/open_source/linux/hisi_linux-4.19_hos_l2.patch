+		.virtual        = HI3536DV100_IOCH3_VIRT,
+		.pfn            = __phys_to_pfn(HI3536DV100_IOCH3_PHYS),
+		.length         = HI3536DV100_IOCH3_SIZE,
+		.type           = MT_DEVICE
+	},
+};
