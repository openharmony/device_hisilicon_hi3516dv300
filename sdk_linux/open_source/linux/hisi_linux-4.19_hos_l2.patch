+#define UFS_HCS_UCRDY_BIT		BIT(3)
+#define UFS_HCS_UPMCRS_OFF		8
+#define UFS_HCS_UPMCRS_MASK		(0x3 << UFS_HCS_UPMCRS_OFF)
+#define UFS_IS_UE_BIT			BIT(2)
