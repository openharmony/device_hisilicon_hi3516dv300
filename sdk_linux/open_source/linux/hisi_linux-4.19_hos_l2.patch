+static noinline int i2c_config_mul_reg(struct i2c_client *client, unsigned long arg)
+{
+	struct i2c_msg msg;
+	unsigned int reg_width;
+	unsigned int data_width;
+	unsigned int reg_data_width;
+
+	if (copy_from_user(&msg,
+			   (struct i2c_msg __user *)arg,
