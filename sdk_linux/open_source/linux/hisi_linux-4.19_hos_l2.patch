+		spi-max-frequency = <25000000>;
+	};
+};
+
+&spi_bus1{
+	status = "okay";
+	num-cs = <3>;
+
+	spidev@0 {
+		compatible = "rohm,dh2228fv";
+		reg = <0>;
+		pl022,interface = <0>;
+		pl022,com-mode = <0>;
+		spi-max-frequency = <25000000>;
+	};
+
+	spidev@1 {
