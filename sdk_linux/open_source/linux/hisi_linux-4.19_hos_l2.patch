+
+void hisi_clk_register_pll(struct hi3531dv200_pll_clock *clks,
+			   int nums, struct hisi_clock_data *data)
+{
+	void __iomem *base = data->base;
+	int i;
+
+	for (i = 0; i < nums; i++) {
+		struct hi3531dv200_clk_pll *p_clk = NULL;
+		struct clk *clk = NULL;
+		struct clk_init_data init;
+
+		p_clk = kzalloc(sizeof(*p_clk), GFP_KERNEL);
+		if (!p_clk)
+			return;
+
+		init.name = clks[i].name;
+		init.flags = CLK_IS_BASIC;
+		init.parent_names =
+			(clks[i].parent_name ? &clks[i].parent_name : NULL);
+		init.num_parents = (clks[i].parent_name ? 1 : 0);
+		init.ops = &clk_pll_ops;
+
+		p_clk->ctrl_reg1 = base + clks[i].ctrl_reg1;
+		p_clk->frac_shift = clks[i].frac_shift;
+		p_clk->frac_width = clks[i].frac_width;
+		p_clk->postdiv1_shift = clks[i].postdiv1_shift;
+		p_clk->postdiv1_width = clks[i].postdiv1_width;
+		p_clk->postdiv2_shift = clks[i].postdiv2_shift;
+		p_clk->postdiv2_width = clks[i].postdiv2_width;
+
+		p_clk->ctrl_reg2 = base + clks[i].ctrl_reg2;
+		p_clk->fbdiv_shift = clks[i].fbdiv_shift;
+		p_clk->fbdiv_width = clks[i].fbdiv_width;
+		p_clk->refdiv_shift = clks[i].refdiv_shift;
+		p_clk->refdiv_width = clks[i].refdiv_width;
+		p_clk->hw.init = &init;
+
+		clk = clk_register(NULL, &p_clk->hw);
+		if (IS_ERR(clk)) {
+			kfree(p_clk);
+			pr_err("%s: failed to register clock %s\n",
+			       __func__, clks[i].name);
+			continue;
+		}
+
+		data->clk_data.clks[clks[i].id] = clk;
+	}
+}
+
+static __init struct hisi_clock_data *hi3531dv200_clk_register(
+	struct platform_device *pdev)
+{
+	struct hisi_clock_data *clk_data;
+	int ret;
+
+	clk_data = hisi_clk_alloc(pdev, HI3531DV200_CRG_NR_CLKS);
+	if (!clk_data)
+		return ERR_PTR(-ENOMEM);
+
+	ret = hisi_clk_register_fixed_rate(hi3531dv200_fixed_rate_clks_crg,
+			ARRAY_SIZE(hi3531dv200_fixed_rate_clks_crg), clk_data);
+	if (ret)
+		return ERR_PTR(ret);
+
+	hisi_clk_register_pll(hi3531dv200_pll_clks,
+			      ARRAY_SIZE(hi3531dv200_pll_clks), clk_data);
+
+	ret = hisi_clk_register_mux(hi3531dv200_mux_clks_crg,
+				    ARRAY_SIZE(hi3531dv200_mux_clks_crg),
+				    clk_data);
+	if (ret)
+		goto unregister_fixed_rate;
+
+	ret = hisi_clk_register_fixed_factor(hi3531dv200_fixed_factor_clks,
+		ARRAY_SIZE(hi3531dv200_fixed_factor_clks), clk_data);
+	if (ret)
+		goto unregister_mux;
+
+	ret = hisi_clk_register_gate(hi3531dv200_gate_clks,
+				     ARRAY_SIZE(hi3531dv200_gate_clks),
+				     clk_data);
+	if (ret)
+		goto unregister_factor;
+
+	ret = of_clk_add_provider(pdev->dev.of_node,
+				  of_clk_src_onecell_get, &clk_data->clk_data);
+	if (ret)
+		goto unregister_gate;
+
+	return clk_data;
+
+unregister_gate:
+	hisi_clk_unregister_gate(hi3531dv200_gate_clks,
+				 ARRAY_SIZE(hi3531dv200_gate_clks), clk_data);
+unregister_factor:
+	hisi_clk_unregister_fixed_factor(hi3531dv200_fixed_factor_clks,
+			ARRAY_SIZE(hi3531dv200_fixed_factor_clks), clk_data);
+unregister_mux:
+	hisi_clk_unregister_mux(hi3531dv200_mux_clks_crg,
+				ARRAY_SIZE(hi3531dv200_mux_clks_crg),
+				clk_data);
+unregister_fixed_rate:
+	hisi_clk_unregister_fixed_rate(hi3531dv200_fixed_rate_clks_crg,
+			ARRAY_SIZE(hi3531dv200_fixed_rate_clks_crg), clk_data);
+	return ERR_PTR(ret);
+}
+
+static __init void hi3531dv200_clk_unregister(const struct platform_device *pdev)
+{
+	struct hisi_crg_dev *crg = platform_get_drvdata(pdev);
+
+	of_clk_del_provider(pdev->dev.of_node);
+
+	hisi_clk_unregister_gate(hi3531dv200_gate_clks,
+			ARRAY_SIZE(hi3531dv200_gate_clks), crg->clk_data);
+	hisi_clk_unregister_mux(hi3531dv200_mux_clks_crg,
+			ARRAY_SIZE(hi3531dv200_mux_clks_crg), crg->clk_data);
+	hisi_clk_unregister_fixed_factor(hi3531dv200_fixed_factor_clks,
+		ARRAY_SIZE(hi3531dv200_fixed_factor_clks), crg->clk_data);
+	hisi_clk_unregister_fixed_rate(hi3531dv200_fixed_rate_clks_crg,
+		ARRAY_SIZE(hi3531dv200_fixed_rate_clks_crg), crg->clk_data);
+}
+
+static const struct hisi_crg_funcs hi3531dv200_crg_funcs = {
+	.register_clks = hi3531dv200_clk_register,
+	.unregister_clks = hi3531dv200_clk_unregister,
+};
+
+
+static const struct of_device_id hi3531dv200_crg_match_table[] = {
+	{
+		.compatible = "hisilicon,hi3531dv200-clock",
+		.data = &hi3531dv200_crg_funcs
+	},
+	{ }
+};
+MODULE_DEVICE_TABLE(of, hi3531dv200_crg_match_table);
+
+static int hi3531dv200_crg_probe(struct platform_device *pdev)
+{
+	struct hisi_crg_dev *crg;
+
+	crg = devm_kmalloc(&pdev->dev, sizeof(*crg), GFP_KERNEL);
+	if (!crg)
+		return -ENOMEM;
+
+	crg->funcs = of_device_get_match_data(&pdev->dev);
+	if (!crg->funcs)
+		return -ENOENT;
+
+	crg->rstc = hisi_reset_init(pdev);
+	if (!crg->rstc)
+		return -ENOMEM;
+
+	crg->clk_data = crg->funcs->register_clks(pdev);
+	if (IS_ERR(crg->clk_data)) {
+		hisi_reset_exit(crg->rstc);
+		return PTR_ERR(crg->clk_data);
+	}
+
+	platform_set_drvdata(pdev, crg);
+	return 0;
+}
+
+static int hi3531dv200_crg_remove(struct platform_device *pdev)
+{
+	struct hisi_crg_dev *crg = platform_get_drvdata(pdev);
+
+	hisi_reset_exit(crg->rstc);
+	crg->funcs->unregister_clks(pdev);
+	return 0;
+}
+
+static struct platform_driver hi3531dv200_crg_driver = {
+	.probe          = hi3531dv200_crg_probe,
+	.remove     = hi3531dv200_crg_remove,
+	.driver         = {
+		.name   = "hi3531dv200-clock",
+		.of_match_table = hi3531dv200_crg_match_table,
+	},
+};
+
+static int __init hi3531dv200_crg_init(void)
+{
+	return platform_driver_register(&hi3531dv200_crg_driver);
+}
+core_initcall(hi3531dv200_crg_init);
+
+static void __exit hi3531dv200_crg_exit(void)
+{
+	platform_driver_unregister(&hi3531dv200_crg_driver);
+}
+module_exit(hi3531dv200_crg_exit);
+
+MODULE_LICENSE("GPL v2");
+MODULE_DESCRIPTION("HiSilicon Hi3531DV200 CRG Driver");
