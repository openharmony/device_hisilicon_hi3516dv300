+	writel(0x40700, misc_base + HISI_COMB_PHY1_TEST_CTRL);
+	writel(0x0, misc_base + HISI_COMB_PHY1_TEST_CTRL);
+
+	writel(0x50300, misc_base + HISI_COMB_PHY1_TEST_CTRL);
+	writel(0x50301, misc_base + HISI_COMB_PHY1_TEST_CTRL);
+	writel(0x50300, misc_base + HISI_COMB_PHY1_TEST_CTRL);
+	writel(0x0, misc_base + HISI_COMB_PHY1_TEST_CTRL);
+
+	writel(0x11100, misc_base + HISI_COMB_PHY1_TEST_CTRL);
+	writel(0x11101, misc_base + HISI_COMB_PHY1_TEST_CTRL);
+	writel(0x11100, misc_base + HISI_COMB_PHY1_TEST_CTRL);
+	writel(0x0, misc_base + HISI_COMB_PHY1_TEST_CTRL);
+
+	writel(0xC00C00, misc_base + HISI_COMB_PHY1_TEST_CTRL);
+	writel(0xC00C01, misc_base + HISI_COMB_PHY1_TEST_CTRL);
+	writel(0xC00C00, misc_base + HISI_COMB_PHY1_TEST_CTRL);
+	writel(0x0, misc_base + HISI_COMB_PHY1_TEST_CTRL);
+
+	writel(0xd80d00, misc_base + HISI_COMB_PHY1_TEST_CTRL);
+	writel(0xd80d01, misc_base + HISI_COMB_PHY1_TEST_CTRL);
+	writel(0xd80d00, misc_base + HISI_COMB_PHY1_TEST_CTRL);
+	writel(0x0, misc_base + HISI_COMB_PHY1_TEST_CTRL);
+}
+
+static void hisi_sata_port_cfg(void)
+{
+	void *misc_base = NULL;
+
+	misc_base = ioremap(HISI_MISC_REG_BASE, HISI_MISC_REG_MAP_SIZE);
+	if (!misc_base) {
+		pr_err("ioremap misc reg failed! func:%s, line:%d\n", __func__, __LINE__);
+		return;
+	}
+
+	switch (ports_num) {
+	case 2:
+		/* cfg COMBPHY1 PORT B */
+		hisi_sata_port1_config(misc_base);
+
+		/* cfg COMBPHY1 PORT A */
+		hisi_sata_port0_config(misc_base);
+		break;
+	default:
+		break;
+	}
+
+	iounmap(misc_base);
+}
+
+#define IOCONFIG1_REG_BASE	0x10ff0000
+#define IOCONFIG1_REG_MAP_SIZE	0x200
+static void hisi_sata_set_led(void)
+{
+	void *reg_addr = NULL;
+	unsigned int port_idx;
+
+	reg_addr = ioremap(IOCONFIG1_REG_BASE, IOCONFIG1_REG_MAP_SIZE);
+	if (reg_addr == NULL) {
+		pr_err("ioremap ioconfg1 register addr for sata failed! func:%s, line:%d\n",
+		       __func__, __LINE__);
+		return;
+	}
+
+	/* Set SATA_LED_N */
+	for (port_idx = 0; port_idx < ports_num; port_idx++) {
+		if (port_idx == 0) {
+			writel(0x1201, reg_addr + 0xFC);
+		} else {
+			writel(0x1201, reg_addr + 0x100);
+		}
+	}
+
+	iounmap(reg_addr);
+}
+
+static void hisi_sata_phy_config(void *mmio, int phy_mode)
+{
+	unsigned int phy_config = PHY_SG_6G;
+	unsigned int port_idx;
+	unsigned int val;
+	void *misc_base = NULL;
+
+	hisi_sata_set_fifoth(mmio);
+
+	// Set SATA_LED_N
+	hisi_sata_set_led();
+
+	/* set phy PX TX amplitude */
+	/* set phy PX TX pre-emphasis */
+	for (port_idx = 0; port_idx < ports_num; port_idx++) {
+		writel(PX_TX_DEEMPH, (mmio + 0x100 + port_idx * 0x80 + HISI_SATA_PORT_PHYCTL2));
+		writel(PX_TX_AMPLITUDE, (mmio + 0x100 + port_idx * 0x80 +
+					 HISI_SATA_PORT_PHYCTL1));
+		writel(phy_config, (mmio + 0x100 + port_idx * 0x80 + HISI_SATA_PORT_PHYCTL3));
+	}
+
+	misc_base = ioremap(HISI_MISC_REG_BASE, HISI_MISC_REG_MAP_SIZE);
+	if (!misc_base) {
+		pr_err("ioremap misc reg failed! func:%s, line:%d\n", __func__, __LINE__);
+		return;
+	}
+
+	switch (ports_num) {
+	case 2:
+		val = readl(misc_base + SATA_PHY_CTRL0);
+		val |= P0_PHY_SERDES_ARCH | P1_PHY_SERDES_ARCH;
+		writel(val, misc_base + SATA_PHY_CTRL0);
+		break;
+	default:
+		break;
+	}
+
+	iounmap(misc_base);
+	hisi_sata_port_cfg();
+}
+
+unsigned int hisi_sata_get_port_info(void)
+{
+	unsigned int sata_port_num = 0;
+
+	sata_port_num = 2;
+	sata_port_map = 0x3;
+
+	return sata_port_num;
+}
