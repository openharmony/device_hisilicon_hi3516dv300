+/* adp crtc global init */
+int hi_adp_crtc_init(void)
+{
+    g_hi_crtcs = kzalloc(sizeof(struct hi_drm_crtc_global), GFP_KERNEL);
+    if (g_hi_crtcs == NULL) {
+        return -ENOMEM;
+    }
+
+    return 0;
+}
