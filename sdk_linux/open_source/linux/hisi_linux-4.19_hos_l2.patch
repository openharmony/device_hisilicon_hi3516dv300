+#define FMC_CMD_WAIT_CPU_FINISH(_host) \
+	do { \
+		unsigned regval, timeout = FMC_WAIT_TIMEOUT * 2; \
+		do { \
+			regval = hifmc_readl((_host), FMC_OP); \
+			--timeout; \
+		} while ((regval & FMC_OP_REG_OP_START) && timeout); \
+		if (!timeout) \
+			pr_info("Error: Wait cmd cpu finish timeout!\n"); \
+	} while (0)
