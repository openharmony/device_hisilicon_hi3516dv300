index 000000000000..3b46205f353b
--- /dev/null
+++ b/drivers/mtd/nand/hifmc100/hifmc100_spi_general.c
@@ -0,0 +1,313 @@
+/*
+ * The Flash Memory Controller v100 Device Driver for hisilicon
