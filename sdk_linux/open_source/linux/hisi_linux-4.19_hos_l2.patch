+#define to_pll_clk(_hw) container_of(_hw, struct hi3535av100_clk_pll, hw)
+static void hi3535av100_calc_pll(u32 *frac_val, u32 *postdiv1_val,
+				 u32 *postdiv2_val,
+				 u32 *fbdiv_val, u32 *refdiv_val, u64 rate)
+{
+	u64 rem;
+	*frac_val = 0;
+	rem = do_div(rate, 1000000);
+	*fbdiv_val = rate / 24;
+	*refdiv_val = 1;
+	rem = rem * (1 << 24);
+	do_div(rem, 1000000);
+	*frac_val = rem;
+}
