+#define VALUE_RMII0_TXD0		0x1051
+#define VALUE_RMII0_TXD1		0x1051
+#define VALUE_RMII0_TXEN		0x1051
+#define VALUE_RMII0_RXD0		0x1031
+#define VALUE_RMII0_RXD1		0x1031
+#define VALUE_RMII0_RXDV		0x1031
+
+/* RMII1 config value */
