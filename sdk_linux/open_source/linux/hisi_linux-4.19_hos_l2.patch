+
+		iocfg_ctrl: iocfg-controller@100c0000 {
+			compatible = "hisilicon,hisi-iocfgctrl", "syscon";
+			reg = <0x100C0000 0x10000>;
+		};
+
+		iocfg_ctrl2: iocfg-controller2@112c0000 {
+			compatible = "hisilicon,hisi-iocfgctrl", "syscon";
+			reg = <0x112C0000 0x10000>;
+		};
+
+		mmc0: sdhci@0x10010000 {
+			compatible = "hisilicon,sdhci";
+			reg = <0x10010000 0x1000>;
+			interrupts = <0 30 4>;
+			clocks = <&clock HI3518EV300_MMC0_CLK>;
+			clock-names = "mmc_clk";
+			resets = <&clock 0x1f4 27>, <&clock 0x1f4 29>;
+			reset-names = "crg_reset", "dll_reset";
+			max-frequency = <150000000>;
+			crg_regmap = <&clock>;
+			iocfg_regmap = <&iocfg_ctrl>;
+			bus-width = <4>;
+			cap-mmc-highspeed;
+			cap-mmc-hw-reset;
+			cap-sd-highspeed;
+			mmc-hs200-1_8v;
+			full-pwr-cycle;
+			disable-wp;
+			devid = <0>;
+			status = "enable";
