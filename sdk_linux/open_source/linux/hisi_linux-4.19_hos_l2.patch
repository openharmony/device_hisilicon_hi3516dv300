+void hisi_sata_reset_rxtx_assert(unsigned int port_no)
+{
+	void *crg_base = NULL;
+	void *comb_phy_crg_base = NULL;
+	unsigned int reg_val;
+
+	comb_phy_crg_base = ioremap((HISI_CRG_REG_BASE + COMB_PHY1_PORT_A_REG), SATA_CRG_MAP_SIZE);
+	if (!comb_phy_crg_base) {
+		pr_err("ioremap comb phy crg base failed! func:%s, line:%d\n", __func__, __LINE__);
+		return;
+	}
+
+	crg_base = ioremap((HISI_CRG_REG_BASE + SATA_CLK_RST_CTRL_1_REG),
+			   SATA_CRG_MAP_SIZE);
+	if (!crg_base) {
+		pr_err("ioremap sata reset register base failed! func:%s, line:%d\n", __func__,
+		       __LINE__);
+		iounmap(comb_phy_crg_base);
+		return;
+	}
+
+	switch (port_no) {
+	case 0:
+		reg_val = readl(crg_base + 0x20);
+		reg_val |= (SATA_CTRL_RXn_RST | SATA_CTRL_SATAn_RST);
+		writel(reg_val, crg_base + 0x20);
+
+		reg_val = readl(comb_phy_crg_base);
+		reg_val |= COMB_PHY_REST;
+		writel(reg_val, comb_phy_crg_base);
+		break;
+	case 1:
+		reg_val = readl(crg_base + 0x40);
+		reg_val |= (SATA_CTRL_RXn_RST | SATA_CTRL_SATAn_RST);
+		writel(reg_val, crg_base + 0x40);
+
+		reg_val = readl(comb_phy_crg_base + 0x20);
+		reg_val |= COMB_PHY_REST;
+		writel(reg_val, comb_phy_crg_base + 0x20);
+		break;
+	default:
+		break;
+	}
+	iounmap(crg_base);
+	iounmap(comb_phy_crg_base);
+}
+EXPORT_SYMBOL(hisi_sata_reset_rxtx_assert);
