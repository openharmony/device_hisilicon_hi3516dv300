index 000000000000..da83abdf9b45
--- /dev/null
+++ b/drivers/phy/hibvt/usb/phy-hisi-usb.c
@@ -0,0 +1,149 @@
+/*
+ * phy-hisi-usb.c
+ *
+ * USB phy driver.
