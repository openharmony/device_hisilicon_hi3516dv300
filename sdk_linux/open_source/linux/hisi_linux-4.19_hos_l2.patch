+int do_mode_change(struct ufs_hba *hba)
+{
+	struct ufs_pa_layer_attr *pwr_mode = &hba->pwr_info;
+
+	/* PA_TxSkip */
+	ufshcd_dme_set_attr(hba, 0x155c0000, 0x0, 0x0, DME_LOCAL);
+	/* PA_TxGear */
+	ufshcd_dme_set_attr(hba, 0x15680000, 0x0, pwr_mode->gear_tx, DME_LOCAL);
+	/* PA_RxGear */
+	ufshcd_dme_set_attr(hba, 0x15830000, 0x0, pwr_mode->gear_rx, DME_LOCAL);
+
+	if (pwr_mode->pwr_rx == FAST_MODE || pwr_mode->pwr_rx == FASTAUTO_MODE) {
+		/* PA_HSSeries */
+		ufshcd_dme_set_attr(hba, 0x156a0000, 0x0, pwr_mode->hs_rate, DME_LOCAL);
+		/* PA_TxTermination */
+		ufshcd_dme_set_attr(hba, 0x15690000, 0x0, 0x1, DME_LOCAL);
+		/* PA_RxTermination */
+		ufshcd_dme_set_attr(hba, 0x15840000, 0x0, 0x1, DME_LOCAL);
+		/* PA_Scrambling */
+		ufshcd_dme_set_attr(hba, 0x15850000, 0x0, 0x1, DME_LOCAL);
+	} else {
+		ufshcd_dme_set_attr(hba, 0x15690000, 0x0, 0x0, DME_LOCAL);
+		ufshcd_dme_set_attr(hba, 0x15840000, 0x0, 0x0, DME_LOCAL);
+		ufshcd_dme_set_attr(hba, 0x15850000, 0x0, 0x0, DME_LOCAL);
+	}
+
+	/* PA_ActiveTxDataLanes */
+	ufshcd_dme_set_attr(hba, 0x15600000, 0x0, pwr_mode->lane_tx, DME_LOCAL);
+	/* PA_ActiveRxDataLanes */
+	ufshcd_dme_set_attr(hba, 0x15800000, 0x0, pwr_mode->lane_rx, DME_LOCAL);
+
+	ufshcd_dme_set_attr(hba, 0x15b00000, 0x0, 0x1FFF,
+			    DME_LOCAL); /* PA_PWRModeUserData0 */
+	ufshcd_dme_set_attr(hba, 0x15b10000, 0x0, 0xFFFF,
+			    DME_LOCAL); /* PA_PWRModeUserData1 */
+	ufshcd_dme_set_attr(hba, 0x15b20000, 0x0, 0x7FFF,
+			    DME_LOCAL); /* PA_PWRModeUserData2 */
+	ufshcd_dme_set_attr(hba, 0xd0410000, 0x0, 0x1FFF,
+			    DME_LOCAL); /* DME_FC0ProtectionTimeOutVal */
+	ufshcd_dme_set_attr(hba, 0xd0420000, 0x0, 0xFFFF,
+			    DME_LOCAL); /* DME_TC0ReplayTimeOutVal */
+	ufshcd_dme_set_attr(hba, 0xd0430000, 0x0, 0x7FFF,
+			    DME_LOCAL); /* DME_AFC0ReqTimeOutVal */
+	ufshcd_dme_set_attr(hba, 0x15b30000, 0x0, 0x1FFF,
+			    DME_LOCAL); /* PA_PWRModeUserData3 */
+	ufshcd_dme_set_attr(hba, 0x15b40000, 0x0, 0xFFFF,
+			    DME_LOCAL); /* PA_PWRModeUserData4 */
+	ufshcd_dme_set_attr(hba, 0x15b50000, 0x0, 0x7FFF,
+			    DME_LOCAL); /* PA_PWRModeUserData5 */
+	ufshcd_dme_set_attr(hba, 0xd0440000, 0x0, 0x1FFF,
+			    DME_LOCAL); /* DME_FC1ProtectionTimeOutVal */
+	ufshcd_dme_set_attr(hba, 0xd0450000, 0x0, 0xFFFF,
+			    DME_LOCAL); /* DME_TC1ReplayTimeOutVal */
+	ufshcd_dme_set_attr(hba, 0xd0460000, 0x0, 0x7FFF,
+			    DME_LOCAL); /* DME_AFC1ReqTimeOutVal */
+
+	/* VS_DebugCounter0Mask */
+	ufshcd_dme_set_attr(hba, 0xd09a0000, 0x0, 0x80000000, DME_LOCAL);
+	/* VS_DebugCounter1Mask */
+	ufshcd_dme_set_attr(hba, 0xd09b0000, 0x0, 0x78000000, DME_LOCAL);
+
+	/* PA_PWRMode */
+	ufshcd_dme_set_attr(hba, 0x15710000, 0x0,
+			    (pwr_mode->pwr_rx << 4) | pwr_mode->pwr_tx, DME_LOCAL); /* rx shift 4 */
+
+	return 0;
+}
+
+static struct ufs_adapt_reg reglist_pll[] = {
+	/*         addr    G3RB  G3RA  G2RB  G2RA  G1RB  G1RA  PWM */
+	{RG_PLL_PRE_DIV, {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}},
+	{RG_PLL_SWC_EN,  {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}},
+	{RG_PLL_FBK_S,   {0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x00}},
+	{RG_PLL_FBK_P,   {0x4c, 0x41, 0x4c, 0x41, 0x4c, 0x41, 0x00}},
+	{RG_PLL_TXHSGR,  {0x00, 0x00, 0x01, 0x01, 0x02, 0x02, 0x00}},
+	{RG_PLL_RXHSGR,  {0x00, 0x00, 0x01, 0x01, 0x02, 0x02, 0x00}}
+};
+
+static void adapt_pll_to_power_mode(struct ufs_hba *hba)
+{
+	int i, mode;
+	struct ufs_pa_layer_attr *pmp = &hba->pwr_info;
+
+	if (pmp->pwr_rx == FAST_MODE || pmp->pwr_rx == FASTAUTO_MODE) {
+		mode = 8 - pmp->gear_rx * 2 - pmp->hs_rate; /* mode[8 - gear * 2 - rate] */
+	} else {
+		/* the PWM's clk is been derived from the pll above */
+		if (pmp->gear_rx == UFS_PWM_G1) {
+			ufshcd_dme_set_attr(hba, RG_PLL_TXLSGR, 0x00, 0x07, DME_LOCAL);
+			ufshcd_dme_set_attr(hba, RG_PLL_RXLSGR, 0x00, 0x06, DME_LOCAL);
+		} else if (pmp->gear_rx == UFS_PWM_G2) {
+			ufshcd_dme_set_attr(hba, RG_PLL_TXLSGR, 0x00, 0x06, DME_LOCAL);
+			ufshcd_dme_set_attr(hba, RG_PLL_RXLSGR, 0x00, 0x05, DME_LOCAL);
+		} else if (pmp->gear_rx == UFS_PWM_G3) {
+			ufshcd_dme_set_attr(hba, RG_PLL_TXLSGR, 0x00, 0x05, DME_LOCAL);
+			ufshcd_dme_set_attr(hba, RG_PLL_RXLSGR, 0x00, 0x04, DME_LOCAL);
+		} else if (pmp->gear_rx == UFS_PWM_G4) {
+			ufshcd_dme_set_attr(hba, RG_PLL_TXLSGR, 0x00, 0x04, DME_LOCAL);
+			ufshcd_dme_set_attr(hba, RG_PLL_RXLSGR, 0x00, 0x03, DME_LOCAL);
+		}
+		return;
+	}
+
+	for (i = 0; i < sizeof(reglist_pll) / sizeof(reglist_pll[0]); i++)
+		ufshcd_dme_set_attr(hba, reglist_pll[i].addr, 0x0,
+				    reglist_pll[i].value[mode], DME_LOCAL);
+}
+
+static int change_power_mode(struct ufs_hba *hba)
+{
+	int err;
+	u32 set;
+	uint32_t value;
+	int retry = 1000; /* retry 1000 times */
+	u32 auto_chg;
+
+	set = ufshcd_readl(hba, REG_INTERRUPT_ENABLE);
+	set &= ~UFS_IS_UPMS_BIT;
+	ufshcd_writel(hba, set, REG_INTERRUPT_ENABLE);
+
+#ifdef UFS_USE_HISI_MPHY_TC
+	ufshcd_dme_get_attr(hba, 0xdf0000, &auto_chg, DME_LOCAL);
+	printk("auto_chg = %#x\n", auto_chg);
+	if ((~auto_chg) & VCO_AUTO_CHG_EN)
+		adapt_pll_to_power_mode(hba);
+#endif
+	adapt_mode_change(hba);
+	err = do_mode_change(hba);
+	if (err) {
+		UFS_PRINT("do_mode_change failed\n");
+		return err;
+	}
+
+	while (--retry) {
+		value = ufshcd_readl(hba, REG_INTERRUPT_STATUS);
+		if (value & UFS_IS_UPMS_BIT) {
+			ufshcd_writel(hba, value, REG_INTERRUPT_STATUS);
+			break;
+		}
+		msleep(1);
+	}
+
+	set |= UFS_IS_UPMS_BIT;
+	ufshcd_writel(hba, set, REG_INTERRUPT_ENABLE);
+
+	if (retry <= 0)
+		UFS_PRINT("\nwait IS.UPMS time out value:%#X\n", value);
+
+	value = ufshcd_readl(hba, REG_CONTROLLER_STATUS);
+	if (((value & UFS_HCS_UPMCRS_MASK) >> UFS_HCS_UPMCRS_OFF) != 0x1) {
+		UFS_PRINT("check HCS.UPMCRS error, HCS = 0x%x\n", value);
+		return -1;
+	}
+	UFS_PRINT("power mode change success\n");
+	/* RX_ERR_STATUS */
+	ufshcd_dme_set_attr(hba, 0x00c40004, 0x0, 0x80, DME_LOCAL);
+	/* RX_ERR_STATUS */
+	ufshcd_dme_set_attr(hba, 0x00c50004, 0x0, 0x01, DME_LOCAL);
+	/* RX_ERR_STATUS */
+	ufshcd_dme_set_attr(hba, 0x00c40005, 0x0, 0x80, DME_LOCAL);
+	/* RX_ERR_STATUS */
+	ufshcd_dme_set_attr(hba, 0x00c50005, 0x0, 0x01, DME_LOCAL);
+
+	return SUCCESS;
+}
+
+static void get_mode_param(struct ufs_hba *hba)
+{
+	struct ufs_pa_layer_attr *dev_req_params = &hba->pwr_info;
+
+	dev_req_params->pwr_rx = hba->hc_pwm;
+	dev_req_params->pwr_tx = hba->hc_pwm;
+
+	dev_req_params->gear_rx = hba->hc_gear;
+	dev_req_params->gear_tx = hba->hc_gear;
+
+	dev_req_params->hs_rate = hba->hc_rate;
+
+	dev_req_params->lane_rx = hba->lanes_per_direction;
+	dev_req_params->lane_tx = hba->lanes_per_direction;
+}
+
+static int hiufs_pwr_change_notify(struct ufs_hba *hba,
+				   enum ufs_notify_change_status status,
+				   struct ufs_pa_layer_attr *dev_max_params,
+				   struct ufs_pa_layer_attr *dev_req_params)
+{
+	if (status == PRE_CHANGE) {
+		get_mode_param(hba);
+		*dev_max_params = hba->pwr_info;
+		*dev_req_params = hba->pwr_info;
+
+		adapt_mode_change(hba);
+		if (change_power_mode(hba))
+			return -1;
+	}
+	return 0;
+}
+
+static struct ufs_hba_variant_ops hiufs_pltfm_hba_vops = {
+	.name = "hiufs_pltfm",
+	.link_startup_notify = hiufs_link_startup_notify,
+	.pwr_change_notify = hiufs_pwr_change_notify,
+	.clk_hareware_init_notify = hiufs_clk_hardware_init_notify,
+};
+
+static const struct of_device_id hiufs_pltfm_pm_match[] = {
+	{
+		.compatible = "hiufs,hiufs_pltfm",
+		.data = &hiufs_pltfm_hba_vops,
+	},
+	{ },
+};
+MODULE_DEVICE_TABLE(of, hiufs_pltfm_pm_match);
+
+static int hiufs_pltfm_probe(struct platform_device *pdev)
+{
+	int err;
+	void __iomem *crg_base;
+	void __iomem *misc_base;
+	struct resource *mem_res = NULL;
+	const struct of_device_id *of_id;
+	struct ufs_hba_variant_ops *vops;
+	struct device *dev = &pdev->dev;
+
+	of_id = of_match_node(hiufs_pltfm_pm_match, dev->of_node);
+	vops = (struct ufs_hba_variant_ops *)of_id->data;
+
+	mem_res = platform_get_resource(pdev, IORESOURCE_MEM, 1); /* 1: crg addr */
+	crg_base = devm_ioremap(dev, mem_res->start, resource_size(mem_res));
+	if (IS_ERR(crg_base))
+		return PTR_ERR(crg_base);
+	g_remap_vir_add.crg_base = crg_base;
+	mem_res = platform_get_resource(pdev, IORESOURCE_MEM, 2); /* 2: misc addr */
+	misc_base = devm_ioremap(dev, mem_res->start, resource_size(mem_res));
+	if (IS_ERR(misc_base))
+		return PTR_ERR(misc_base);
+	g_remap_vir_add.misc_base = misc_base;
+	hiufs_pltfm_clk_init(crg_base);
+	hiufs_pltfm_hardware_init(misc_base);
+
+	/* Perform generic probe */
+	err = ufshcd_pltfrm_init(pdev, vops);
+	if (err)
+		dev_err(dev, "ufshcd_pltfrm_init() failed %d\n", err);
+
+	return err;
+}
+
+static int hiufs_pltfm_remove(struct platform_device *pdev)
+{
+	struct ufs_hba *hba =  platform_get_drvdata(pdev);
+
+	pm_runtime_get_sync(&(pdev)->dev);
+	ufshcd_remove(hba);
+
+	return 0;
+}
+
+static const struct dev_pm_ops hiufs_pltfm_pm_ops = {
+	.suspend         = ufshcd_pltfrm_suspend,
+	.resume          = ufshcd_pltfrm_resume,
+	.runtime_suspend = ufshcd_pltfrm_runtime_suspend,
+	.runtime_resume  = ufshcd_pltfrm_runtime_resume,
+	.runtime_idle    = ufshcd_pltfrm_runtime_idle,
+};
+
+static struct platform_driver hiufs_pltfm_driver = {
+	.probe = hiufs_pltfm_probe,
+	.remove = hiufs_pltfm_remove,
+	.shutdown = ufshcd_pltfrm_shutdown,
+	.driver = {
+		.name = "hiufs_pltfm",
+		.pm = &hiufs_pltfm_pm_ops,
+		.of_match_table = of_match_ptr(hiufs_pltfm_pm_match),
+	},
+};
+
+module_platform_driver(hiufs_pltfm_driver);
+
+MODULE_LICENSE("Dual BSD/GPL");
