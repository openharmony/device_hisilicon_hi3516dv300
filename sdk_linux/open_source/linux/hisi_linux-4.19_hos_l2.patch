+
+MODULE_AUTHOR("Hisilicon");
+MODULE_DESCRIPTION("Hisilicon RTC driver");
+MODULE_LICENSE("GPL v2");
+MODULE_VERSION("HI_VERSION=" OSDRV_MODULE_VERSION_STRING);
