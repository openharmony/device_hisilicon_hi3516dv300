+
+/* debug control */
+extern int hiedmacv310_trace_level_n;
+#define HIEDMACV310_TRACE_LEVEL 5
+
+#define HIEDMACV310_TRACE_FMT KERN_INFO
+
+typedef void DMAC_ISR(unsigned int channel, int status);
