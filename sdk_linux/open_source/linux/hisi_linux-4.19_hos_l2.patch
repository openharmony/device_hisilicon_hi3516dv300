+++ b/drivers/phy/hibvt/Kconfig
@@ -0,0 +1,23 @@
+config PHY_HISI_SATA
+	tristate "Hisilicon sata phy support"
+	depends on (ARCH_HI3531DV200 || ARCH_HI3535AV100 || ARCH_HI3521DV200 || ARCH_HI3520DV500) && OF && HAS_IOMEM
+	default n
+	select GENERIC_PHY
