+
+#define REG_SIZE_BYTES			4
+
+static u32 higmac_pinctrl_writel(struct platform_device *pdev, u32 val,
+				 resource_size_t phyaddr)
+{
+	void __iomem *pinout = NULL;
+
+	pinout = devm_ioremap(&pdev->dev, phyaddr, REG_SIZE_BYTES);
+	if (!pinout) {
+		pr_err("higmac devm_ioremap error!\n");
+		return ENOMEM;
+	}
+	writel(val, pinout);
+	devm_iounmap(&pdev->dev, pinout);
+
+	return 0;
+}
+
+static int higmac_config_rgmii0(struct platform_device *pdev)
+{
+	unsigned int ret;
+
+	ret = higmac_pinctrl_writel(pdev, VALUE_MDCK0, PHY_ADDR_MDCK0);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_MDIO0, PHY_ADDR_MDIO0);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_EPHY0_CLK, PHY_ADDR_EPHY0_CLK);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_EPHY0_RSTN, PHY_ADDR_EPHY0_RSTN);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII0_TXCKOUT,
+				     PHY_ADDR_RGMII0_TXCKOUT);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII0_TXD0, PHY_ADDR_RGMII0_TXD0);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII0_TXD1, PHY_ADDR_RGMII0_TXD1);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII0_TXD2, PHY_ADDR_RGMII0_TXD2);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII0_TXD3, PHY_ADDR_RGMII0_TXD3);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII0_TXEN, PHY_ADDR_RGMII0_TXEN);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII0_RXCK, PHY_ADDR_RGMII0_RXCK);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII0_RXD0, PHY_ADDR_RGMII0_RXD0);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII0_RXD1, PHY_ADDR_RGMII0_RXD1);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII0_RXD2, PHY_ADDR_RGMII0_RXD2);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII0_RXD3, PHY_ADDR_RGMII0_RXD3);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII0_RXDV, PHY_ADDR_RGMII0_RXDV);
+
+	return (int)ret;
+}
+
+static int higmac_config_rgmii1(struct platform_device *pdev)
+{
+	unsigned int ret;
+
+	ret = higmac_pinctrl_writel(pdev, VALUE_MDCK1, PHY_ADDR_MDCK1);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_MDIO1, PHY_ADDR_MDIO1);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_EPHY1_CLK, PHY_ADDR_EPHY1_CLK);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_EPHY1_RSTN, PHY_ADDR_EPHY1_RSTN);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII1_TXCKOUT,
+				     PHY_ADDR_RGMII1_TXCKOUT);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII1_TXD0, PHY_ADDR_RGMII1_TXD0);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII1_TXD1, PHY_ADDR_RGMII1_TXD1);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII1_TXD2, PHY_ADDR_RGMII1_TXD2);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII1_TXD3, PHY_ADDR_RGMII1_TXD3);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII1_TXEN, PHY_ADDR_RGMII1_TXEN);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII1_RXCK, PHY_ADDR_RGMII1_RXCK);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII1_RXD0, PHY_ADDR_RGMII1_RXD0);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII1_RXD1, PHY_ADDR_RGMII1_RXD1);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII1_RXD2, PHY_ADDR_RGMII1_RXD2);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII1_RXD3, PHY_ADDR_RGMII1_RXD3);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RGMII1_RXDV, PHY_ADDR_RGMII1_RXDV);
+
+	return (int)ret;
+}
+
+static int higmac_config_rmii0(struct platform_device *pdev)
+{
+	unsigned int ret;
+
+	ret = higmac_pinctrl_writel(pdev, VALUE_MDCK0, PHY_ADDR_MDCK0);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_MDIO0, PHY_ADDR_MDIO0);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_EPHY0_CLK, PHY_ADDR_EPHY0_CLK);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_EPHY0_RSTN, PHY_ADDR_EPHY0_RSTN);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RMII0_CLK, PHY_ADDR_RMII0_CLK);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RMII0_TXD0, PHY_ADDR_RMII0_TXD0);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RMII0_TXD1, PHY_ADDR_RMII0_TXD1);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RMII0_TXEN, PHY_ADDR_RMII0_TXEN);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RMII0_RXD0, PHY_ADDR_RMII0_RXD0);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RMII0_RXD1, PHY_ADDR_RMII0_RXD1);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RMII0_RXDV, PHY_ADDR_RMII0_RXDV);
+
+	return (int)ret;
+}
+
+static int higmac_config_rmii1(struct platform_device *pdev)
+{
+	unsigned int ret;
+
+	ret = higmac_pinctrl_writel(pdev, VALUE_MDCK1, PHY_ADDR_MDCK1);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_MDIO1, PHY_ADDR_MDIO1);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_EPHY1_CLK, PHY_ADDR_EPHY1_CLK);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_EPHY1_RSTN, PHY_ADDR_EPHY1_RSTN);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RMII1_CLK, PHY_ADDR_RMII1_CLK);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RMII1_TXD0, PHY_ADDR_RMII1_TXD0);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RMII1_TXD1, PHY_ADDR_RMII1_TXD1);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RMII1_TXEN, PHY_ADDR_RMII1_TXEN);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RMII1_RXD0, PHY_ADDR_RMII1_RXD0);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RMII1_RXD1, PHY_ADDR_RMII1_RXD1);
+	ret |= higmac_pinctrl_writel(pdev, VALUE_RMII1_RXDV, PHY_ADDR_RMII1_RXDV);
+
+	return (int)ret;
+}
+
+int hisi_gemac_pinctrl_config(struct platform_device *pdev)
+{
+	struct device_node *np = pdev->dev.of_node;
+	const char *pm = NULL;
+	int err;
+
+	err = of_property_read_string(np, "pinctrl", &pm);
+	if (err) {
+		/* Just print warring, mybe pinctrl config in uboot */
+		pr_warning("higmac have no pinctrl config\n");
+		return 0;
+	}
+
+	pr_info("higmac pinctrl type=%s\n", pm);
+	if (!strcasecmp(pm, "rgmii0"))
+		err = higmac_config_rgmii0(pdev);
+	else if (!strcasecmp(pm, "rgmii1"))
+		err = higmac_config_rgmii1(pdev);
+	else if (!strcasecmp(pm, "rmii0"))
+		err = higmac_config_rmii0(pdev);
+	else if (!strcasecmp(pm, "rmii1"))
+		err = higmac_config_rmii1(pdev);
+	else
+		return -EINVAL;
+
+	return err;
+}
