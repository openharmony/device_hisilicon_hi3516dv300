+			reg = <0x20060000 0x10000>;
+		};
+
+		ir: ir@20070000{
+			compatible = "hisilicon,hi_ir";
+			interrupts = <19>;
+			reg = <0x20070000 0x10000>;
+		};
+
+		cipher: cipher@100c0000{
+			compatible = "hisilicon,hi_cipher";
+			interrupts = <13>;
+			reg = <0x100c0000 0x10000>;
+		};
+	};
+};
