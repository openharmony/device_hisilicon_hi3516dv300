+#define VALUE_MDCK0				0x1821
+#define VALUE_MDIO0				0x1031
+/* MDIO1 config value */
+#define VALUE_MDCK1				0x1822
+#define VALUE_MDIO1				0x1032
+
+/* PHY0 config value */
+#define VALUE_EPHY0_CLK			0x1801
+#define VALUE_EPHY0_RSTN		0x1031
+/* PHY1 config value */
+#define VALUE_EPHY1_CLK			0x1802
+#define VALUE_EPHY1_RSTN		0x1032
+
+/* RGMII0 config value */
+#define VALUE_RGMII0_TXCKOUT	0x1041
+#define VALUE_RGMII0_TXD0		0x1051
+#define VALUE_RGMII0_TXD1		0x1051
+#define VALUE_RGMII0_TXD2		0x1051
+#define VALUE_RGMII0_TXD3		0x1051
+#define VALUE_RGMII0_TXEN		0x1051
+#define VALUE_RGMII0_RXCK		0x1031
+#define VALUE_RGMII0_RXD0		0x1031
+#define VALUE_RGMII0_RXD1		0x1031
