+static void hisi_sata_reset(void)
+{
+	unsigned int reg_val;
+	void *crg_base = NULL;
+
+	crg_base = ioremap((HISI_CRG_REG_BASE + SATA_CLK_RST_CTRL_1_REG),
+			   SATA_CRG_MAP_SIZE);
+	if (!crg_base) {
+		pr_err("ioremap sata reset register base failed! func:%s, line:%d\n", __func__,
+		       __LINE__);
+		return;
+	}
+
+	reg_val = readl(crg_base);
+	reg_val |= HISI_SATA_CKO_ALIVE_SRST_REQ;
+	writel(reg_val, crg_base);
+
+	reg_val = readl(crg_base + 0x8);
+	reg_val |= HISI_SATA_BUS_SRST_REQ;
+	writel(reg_val, crg_base + 0x8);
+
+	switch (ports_num) {
+	case 2:
+		hisi_sata0_rx0_reset(crg_base);
+		hisi_sata1_rx1_reset(crg_base);
+		break;
+	default:
+		break;
+	}
+
+	iounmap(crg_base);
+}
