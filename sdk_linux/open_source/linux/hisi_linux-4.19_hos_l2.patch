+#define DMAC_CxCONTROL_M2M  0x9d480000  /* Dwidth=32,burst size=4 */
+#define DMAC_CxCONTROL_LLIM2M       0x0f480000  /* Dwidth=32,burst size=1 */
+#define DMAC_CxCONTROL_LLIM2M_ISP   0x0b489000  /* Dwidth=32,burst size=1 */
