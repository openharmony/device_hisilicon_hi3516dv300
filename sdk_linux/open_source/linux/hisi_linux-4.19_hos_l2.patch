+	regval = OP_CFG_FM_CS(host->cmd_op.cs);
+	hifmc_writel(host, FMC_OP_CFG, regval);
+
+	regval = FMC_OP_READ_STATUS_EN | FMC_OP_REG_OP_START;
+	hifmc_writel(host, FMC_OP, regval);
