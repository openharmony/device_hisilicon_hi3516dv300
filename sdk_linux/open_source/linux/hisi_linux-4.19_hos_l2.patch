+static void hisi_sata_phy_config(void *mmio, int phy_mode)
+{
+	unsigned int phy_config = PHY_SG_6G;
+	unsigned int port_idx;
+	unsigned int val;
+	void *misc_base = NULL;
+
+	hisi_sata_set_fifoth(mmio);
+
+	/* Set SATA_LED_N */
+	hisi_sata_set_led();
+
+	/* set phy PX TX amplitude */
+	/* set phy PX TX pre-emphasis */
+	for (port_idx = 0; port_idx < ports_num; port_idx++) {
+		writel(PX_TX_PREEMPH, (mmio + 0x100 + port_idx * 0x80 +
+				       HISI_SATA_PORT_PHYCTL2));
+		writel(PX_TX_AMPLITUDE, (mmio + 0x100 + port_idx * 0x80 +
+					 HISI_SATA_PORT_PHYCTL1));
+		writel(phy_config, (mmio + 0x100 + port_idx * 0x80 + HISI_SATA_PORT_PHYCTL3));
+	}
+
+	misc_base = ioremap(HISI_MISC_REG_BASE, HISI_MISC_REG_MAP_SIZE);
+	if (!misc_base) {
+		pr_err("ioremap misc reg failed! func:%s, line:%d\n", __func__, __LINE__);
+		return;
+	}
+
+	switch (ports_num) {
+	case 1:
+		val = readl(misc_base + SATA_PHY_CTRL0);
+		val |= P0_PHY_SERDES_ARCH;
+		writel(val, misc_base + SATA_PHY_CTRL0);
+		break;
+	case 2:
+		val = readl(misc_base + SATA_PHY_CTRL0);
+		val |= P0_PHY_SERDES_ARCH | P1_PHY_SERDES_ARCH;
+		writel(val, misc_base + SATA_PHY_CTRL0);
+		break;
+	case 3:
+		val = readl(misc_base + SATA_PHY_CTRL0);
+		val |= P0_PHY_SERDES_ARCH | P1_PHY_SERDES_ARCH;
+		writel(val, misc_base + SATA_PHY_CTRL0);
+
+		val = readl(misc_base + SATA_PHY_CTRL1);
+		val |= P2_PHY_SERDES_ARCH;
+		writel(val, misc_base + SATA_PHY_CTRL1);
+		break;
+	case 4:
+		val = readl(misc_base + SATA_PHY_CTRL0);
+		val |= P0_PHY_SERDES_ARCH | P1_PHY_SERDES_ARCH;
+		writel(val, misc_base + SATA_PHY_CTRL0);
+
+		val = readl(misc_base + SATA_PHY_CTRL1);
+		val |= P2_PHY_SERDES_ARCH | P3_PHY_SERDES_ARCH;
+		writel(val, misc_base + SATA_PHY_CTRL1);
+		break;
+	default:
+		break;
+	}
+
+	iounmap(misc_base);
+	hisi_sata_port_cfg();
+}
+
+unsigned int hisi_sata_get_port_info(void)
+{
+	unsigned int ups_mode = 0;
+	unsigned int reg_val = 0;
+	unsigned int sata_port_num = 0;
+	void *sysctrl_reg_base = NULL;
+
+	sysctrl_reg_base = ioremap(HISI_SYS_CTRL_REG_BASE, HISI_SYS_CTRL_REG_MAP_SIZE);
+	if (!sysctrl_reg_base) {
+		pr_err("ioremap sysctrl reg base failed! func:%s, line:%d\n", __func__,
+		       __LINE__);
+		return 0;
+	}
+
+	reg_val = readl(sysctrl_reg_base + HISI_SYS_STAT_REG);
+	ups_mode = GET_UPS_MODE_VAL(reg_val);
+	switch (ups_mode) {
+	case 1:
+		sata_port_num = 1;
+		sata_port_map = 0x1;
+		break;
+	case 2:
+	case 3:
+		sata_port_num = 2;
+		sata_port_map = 0x3;
+		break;
+	case 4:
+		sata_port_num = 3;
+		sata_port_map = 0x7;
+		break;
+	case 5:
+		sata_port_num = 4;
+		sata_port_map = 0xf;
+		break;
+	default:
+		sata_port_num = 0;
+		sata_port_map = 0;
+		break;
+	}
+
+	return sata_port_num;
+}
