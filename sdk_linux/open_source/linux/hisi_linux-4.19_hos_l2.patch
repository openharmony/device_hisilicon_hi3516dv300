+#define PHY_ADDR_RMII1_TXD0		0x017C7020C
+#define PHY_ADDR_RMII1_TXD1		0x017C70214
+#define PHY_ADDR_RMII1_TXEN		0x017C70210
+#define PHY_ADDR_RMII1_RXD0		0x017C701E4
