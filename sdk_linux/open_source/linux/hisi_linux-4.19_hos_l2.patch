+	depends on PCI && (ARCH_HI3531DV200 || ARCH_HI3535AV100 || ARCH_HI3559AV100 || ARCH_HI3531A || ARCH_HI3519AV100 || ARCH_HI3568V100 || ARCH_HI3569V100)
