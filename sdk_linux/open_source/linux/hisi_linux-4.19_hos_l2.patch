+				interrupts = <GIC_SPI 1 IRQ_TYPE_LEVEL_HIGH>;
+			};
+
+		};
+
+
+		fmc: flash-memory-controller@10000000 {	//todo
+			compatible = "hisilicon,hisi-fmc";
+			reg = <0x10000000 0x10000>, <0x0F000000 0x100000>;
+			reg-names = "control", "memory";
+			clocks = <&clock HI3521DV200_FMC_CLK>;
+			max-dma-size = <0x2000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			hisfc:spi_nor_controller {
+				compatible = "hisilicon,fmc-spi-nor";
+				assigned-clocks = <&clock HI3521DV200_FMC_CLK>;
+				assigned-clock-rates = <24000000>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+			};
+
+			hisnfc:spi_nand_controller {
+				compatible = "hisilicon,fmc-spi-nand";
+				assigned-clocks = <&clock HI3521DV200_FMC_CLK>;
+				assigned-clock-rates = <24000000>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+			};
+		};
+
+//FEMAC
+        mdio0: mdio@102a1100 {
+            compatible = "hisilicon,hisi-femac-mdio";
+            reg = <0x102a1100 0x10>,<0x11024218 0x4>,<0x11020448 0x4>;
+            clocks = <&clock HI3521DV200_ETH1_FEPHY_CLK>;
+            clock-names = "mdio";
+            resets = <&clock 0x37d0 0>;
+            reset-names = "internal-phy";
+            #address-cells = <1>;
+            #size-cells = <0>;
+        };
+
+        hisi_femac0: ethernet@102a0000 {
+            compatible = "hisilicon,hisi-femac-v2";
+            reg = <0x102a0000 0x1000>,<0x102a1300 0x200>;
+            interrupts = <GIC_SPI 76 IRQ_TYPE_LEVEL_HIGH>;
+            clocks = <&clock HI3521DV200_ETH1_CLK>;
+            resets = <&clock 0x37c8 0>;
+            reset-names = "mac";
+        };
+
+		iocfg_ctrl: iocfg-controller@10ff0000 {
+			compatible = "hisilicon,hisi-iocfgctrl", "syscon";
+			reg = <0x10ff0000 0x10000>;
+		};
+
+		/*EMMC/SD/SDIO DTS nodes*/
+		mmc0: eMMC@0x10020000 {
+			compatible = "hisilicon,sdhci";
+			reg = <0x10020000 0x1000>;
+			interrupts = <GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clock HI3521DV200_MMC0_CLK>;
+			clock-names = "mmc_clk";
+			resets = <&clock 0x34c0 16>, <&clock 0x34c4 1>;
+			reset-names = "crg_reset", "dll_reset";
+			max-frequency = <148500000>;
+			crg_regmap = <&clock>;
+			iocfg_regmap = <&iocfg_ctrl>;
+			non-removable;
+			bus-width = <8>;
+			cap-mmc-highspeed;
+			mmc-hs200-1_8v;
+			mmc-hs400-1_8v;
+			mmc-hs400-enhanced-strobe;
+			cap-mmc-hw-reset;
+			no-sdio;
+			no-sd;
+			devid = <0>;
+			status = "disabled";
+		};
+
+		mmc1: SD@0x10200000 {
+			compatible = "hisilicon,sdhci";
+			reg = <0x10020000 0x1000>;
+			interrupts = <GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clock HI3521DV200_MMC0_CLK>;
+			clock-names = "mmc_clk";
+			resets = <&clock 0x34c0 16>, <&clock 0x34c4 1>;
+			reset-names = "crg_reset", "dll_reset";
+			max-frequency = <50000000>;
+			crg_regmap = <&clock>;
+			iocfg_regmap = <&iocfg_ctrl>;
+			bus-width = <4>;
+			cap-sd-highspeed;
+			disable-wp;
+			no-sdio;
+			devid = <1>;
+			status = "disabled";
+		};
+
+		mmc2: SDIO@0x10200000 {
+			compatible = "hisilicon,sdhci";
+			reg = <0x10020000 0x1000>;
+			interrupts = <GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clock HI3521DV200_MMC0_CLK>;
+			clock-names = "mmc_clk";
+			resets = <&clock 0x34c0 16>, <&clock 0x34c4 1>;
+			reset-names = "crg_reset", "dll_reset";
+			max-frequency = <150000000>;
+			crg_regmap = <&clock>;
+			iocfg_regmap = <&iocfg_ctrl>;
+			bus-width = <4>;
+			cap-sd-highspeed;
+			sd-uhs-sdr104;
+			non-removable;
+			devid = <2>;
+			status = "disabled";
+		};
+
+		/*USB DTS nodes*/
+		usbphy: USB {
+			compatible = "hisilicon,hisi-usb-phy";
+			reg = <0x110138c0 0x280>, <0x11024188 0x10>, <0x11020444 0x4>;
+		};
+
+		xhci_0:xhci_0@0x10300000 {
+			compatible = "generic-xhci";
+			reg = <0x10300000 0x10000>;
+			interrupts = <0 79 4>;
+			usb2-lpm-disable;
+		};
+
+		xhci_1:xhci_1@0x10340000 {
+			compatible = "generic-xhci";
+			reg = <0x10340000 0x10000>;
+			interrupts = <0 80 4>;
+			usb2-lpm-disable;
+		};
+
+		sata_phy: phy@0x10390000 {
+			compatible = "hisilicon,hisi-sata-phy";
+			reg = <0x10390000 0x10000>;
+			ports_num_max = <2>;
+			#phy-cells = <0>;
+		};
+
+		ahci: sata@0x10390000 {
+			compatible = "hisilicon,hisi-ahci";
+			reg = <0x10390000 0x1000>;
+			interrupts = <GIC_SPI 81 IRQ_TYPE_LEVEL_HIGH>;
+			phys = <&sata_phy>;
+			phy-names = "sata-phy";
+			#address-cells = <1>;
+			#size-cells = <0>;
+		};
+
+		cipher: cipher@0x10100000 {
+			compatible = "hisilicon,hisi-cipher";
+			reg = <0x10100000 0x10000>;
+			reg-names = "cipher";
+			interrupts = <GIC_SPI 68 IRQ_TYPE_LEVEL_HIGH>,
+						<GIC_SPI 68 IRQ_TYPE_LEVEL_HIGH>,
+						<GIC_SPI 69 IRQ_TYPE_LEVEL_HIGH>,
+						<GIC_SPI 69 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "cipher","hash","nonsec_cipher","nonsec_hash";
+		};
+
+		otp: otp@0x10200000 {
+			compatible = "hisilicon,hisi-otp";
+			reg = <0x10200000 0x1000>;
+			reg-names = "otp";
+		};
+
+		wdg: wdg@0x11030000 {
+			compatible = "hisilicon,hi_wdg";
+			reg = <0x11030000 0x1000>;
+			reg-names = "hi_wdg";
+			interrupts = <GIC_SPI 4 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "hi_wdg";
+        };
+
+	};
+
+	media {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		compatible = "simple-bus";
+		ranges;
+
+		osal: osal {
+			compatible = "hisilicon,osal";
+		};
+
+		sys: sys@11010000 {
+			compatible = "hisilicon,hisi-sys";
+			reg = <0x11014500 0xBB00>,
+				<0x11020450 0x3BB0>,
+				<0x11130000 0x10000>,
+				<0X11024000 0x5000>;
+			reg-names = "crg", "sys", "ddr", "misc";
+		};
+
+		vi: vi@0x17400000 {
+			compatible = "hisilicon,hisi-vi";
+			reg = <0x17400000 0x40000>,
+			      <0x11003000 0x1000>;
+			reg-names = "vi_cap", "vi_timer";
+			interrupts = <0 93 4>,
+				<GIC_SPI 11 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "vi_cap", "vi_timer";
+		};
+
+		mipi: mipi@0x173c0000 {
+			compatible = "hisilicon,hisi-mipi";
+			reg = <0x173c0000 0x10000>;
+			reg-names = "mipi";
+			interrupts = <0 92 4>;
+			interrupt-names = "mipi";
+		};
+
+		vpss: vpss@0x17900000 {
+			compatible = "hisilicon,hisi-vpss";
+			reg = <0x17900000 0x10000>;
+			reg-names = "vpss";
+			interrupts = <0 102 4>;
+			interrupt-names = "vpss";
+		};
+
+		vgs: vgs@0x17240000 {
+		    compatible = "hisilicon,hisi-vgs";
+		    reg = <0x17240000 0x10000>;
+		    reg-names = "vgs";
+		    interrupts = <0 105 4>;
+		    interrupt-names = "vgs";
+		};
+
+		vo: vo@0x17a00000 {
+			compatible = "hisilicon,hisi-vo";
+			reg = <0x17a00000 0x40000>;
+			reg-names = "vo";
+			interrupts = <0 95 4>;
+			interrupt-names = "vo";
+		};
+
+		hifb: hifb@0x17a00000 {
+			compatible = "hisilicon,hisi-hifb";
+			reg-names = "hifb";
+			interrupts = <0 96 4>;
+			interrupt-names = "hifb";
+		};
+
+		hdmi: hdmi@0x17B40000 {
+			compatible = "hisilicon,hisi-hdmi";
+			reg = <0x17B40000 0x20000>,<0x17BC0000 0x10000>;
+			reg-names = "hdmi0","phy";
+			interrupts = <0 98 4>,<0 99 4>,<0 100 4>;
+			interrupt-names = "tx_aon","tx_pwd","tx_sec";
+		};
+
+		venc: venc@0x17140000 {
+			compatible = "hisilicon,hisi-vedu";
+			reg = <0x17140000 0x10000>, <0x171c0000 0x10000>;
+			reg-names = "vedu0", "jpge";
+			interrupts = <0 111 4>, <0 113 4>;
+			interrupt-names = "vedu0","jpge";
+		};
+
+		vdh: vdh@0x17100000 {
+			compatible = "hisilicon,hisi-vdh";
+			reg = <0x17100000 0x10000>;
+			reg-names = "vdh_scd";
+			interrupts = <0 109 4>,<0 108 4>;
+			interrupt-names = "vdh_pxp", "scd";
+		};
+
+		jpegd: jpegd@0x17180000 {
+			compatible = "hisilicon,hisi-jpegd";
+			reg = <0x17180000 0x10000>;
+			reg-names = "jpegd";
+			interrupts = <0 114 4>;
+			interrupt-names = "jpegd";
+		};
+
+		vda: vda@0x170c0000 {
+			compatible = "hisilicon,hisi-vda";
+			reg = <0x170c0000 0x10000>;
+			reg-names = "vda";
+			interrupts = <0 119 4>;
+			interrupt-names = "vda";
+		};
+
+		nnie: nnie@0x170D0000 {
+			compatible = "hisilicon,hisi-nnie";
+			reg = <0x170D0000 0x10000>;
+			reg-names = "nnie0";
+			interrupts = <0 116 4>;
+			interrupt-names = "nnie0";
+		};
+
+		ive: ive@0x17000000 {
+			compatible = "hisilicon,hisi-ive";
+			reg = <0x17000000 0x10000>;
+			reg-names = "ive";
+			interrupts = <0 117 4>;
+			interrupt-names = "ive";
+		};
+
+		mau: mau@0x170E0000 {
+			compatible = "hisilicon,hisi-mau";
+			reg = <0x170E0000 0x10000>;
+			reg-names = "mau0";
+			interrupts = <0 118 4>;
+			interrupt-names = "mau0";
+		};
+
+		aiao: aiao@17c00000 {
+			compatible = "hisilicon,hisi-aiao";
+			reg = <0x17c00000 0x10000>;
+			reg-names = "aiao";
+			interrupts = <0 97 4>;
+			interrupt-names = "AIO";
+		};
+
+		tde: tde@0x17280000 {
+			compatible = "hisilicon,hisi-tde";
+			reg = <0x17280000 0x10000>;
+			reg-names = "tde";
+			interrupts = <0 106 4>;
+			interrupt-names = "tde_osr_isr";
+		};
+
+		ir: ir@0x110F0000 {
+			compatible = "hisilicon,hi-ir";
+			reg = <0x110F0000 0x10000>;
+			reg-names = "hi-ir";
+			interrupts = <0 2 4>;
+			interrupt-names = "hi-ir";
+		};
+	};
+};
diff --git a/arch/arm/boot/dts/hi3531a-demb.dts b/arch/arm/boot/dts/hi3531a-demb.dts
new file mode 100644
index 000000000000..e0a47d7bdb38
--- /dev/null
+++ b/arch/arm/boot/dts/hi3531a-demb.dts
@@ -0,0 +1,146 @@
+/*
