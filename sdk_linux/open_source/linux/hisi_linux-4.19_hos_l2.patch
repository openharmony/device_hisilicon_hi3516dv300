+static void adapt_mode_change(struct ufs_hba *hba)
+{
+	int i, mode;
+	struct ufs_pa_layer_attr *pmp = &hba->pwr_info;
+
+#if defined(COMBO_PHY_V120)
+	if (pmp->pwr_rx == FAST_MODE || pmp->pwr_rx == FASTAUTO_MODE) {
+		mode = 8 - pmp->gear_rx * 2 - pmp->hs_rate; /* mode[8 - gear * 2 - rate] */
+	} else {
+		mode = 6; /* mode[6] : PWM */
+		return; /* PWM is unused here */
+	}
+
+	for (i = 0; i < sizeof(reglist_pmc) / sizeof(reglist_pmc[0]); i++)
+		ufshcd_dme_set_attr(hba, reglist_pmc[i].addr, 0x0,
+				    reglist_pmc[i].value[mode], DME_LOCAL);
+#endif
+}
