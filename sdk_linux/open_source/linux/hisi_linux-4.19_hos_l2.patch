+	}
+
+	reg_val = readl(crg_base);
+	reg_val &= ~HISI_SATA_CKO_ALIVE_SRST_REQ;
+	writel(reg_val, crg_base);
+
+	reg_val = readl(crg_base + 0x8);
+	reg_val &= ~HISI_SATA_BUS_SRST_REQ;
